{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-chores",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chores-db",
      "database_id": "replace-with-production-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "0.1.0",
    "APP_COMMIT": "unknown"
  },
  "observability": {
    "enabled": false
  }
}
