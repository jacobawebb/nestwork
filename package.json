{
  "name": "family-chores",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --test-scheduled",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "pnpm build && wrangler dev --test-scheduled",
    "deploy": "pnpm check && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply chores-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply chores-db --remote",
    "db:backup": "wrangler d1 export chores-db --remote --output=backup.sql",
    "cron:local": "curl http://localhost:8787/__scheduled?cron=0+*+*+*+*",
    "benchmark:remote": "node scripts/benchmark-remote.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@cloudflare/workers-types": "5.20260828.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/node": "22.20.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
